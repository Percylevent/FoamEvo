# Source this file explicitly after filling in local values.
# The applications do not automatically load .env files.

# Foam-Runner execution model
FOAM_AGENT_MODEL_PROVIDER=openai
FOAM_AGENT_MODEL_VERSION=
FOAM_AGENT_OPENAI_BASE_URL=
FOAM_AGENT_OPENAI_API_KEY=
FOAM_AGENT_ANTHROPIC_BASE_URL=
FOAM_AGENT_ANTHROPIC_API_KEY=
FOAM_AGENT_EMBEDDING_PROVIDER=huggingface
FOAM_AGENT_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
FOAM_AGENT_OPENFOAM_FORK=foundation
FOAM_AGENT_RUN_ROOT=

# Optional OpenAI-compatible embedding endpoint
OPENAI_API_KEY=
OPENAI_API_BASE=

# Foam-Refiner always invokes Claude CLI.
# FOAM_EVO_MODEL_VERSION takes precedence over ANTHROPIC_MODEL.
FOAM_EVO_MODEL_VERSION=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
